# Gemma 4 and embeddings (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL_ID=gemma-4-26b-a4b-it      # Gemma 4 MoE, fastest in testing; gemma-4-31b-it also works
EMBEDDING_MODEL_ID=gemini-embedding-2  # used at 768 dimensions to match law_chunks.embedding

# Sunbird AI: Luganda translation, speech-to-text, text-to-speech (https://sunbird.ai)
SUNBIRD_API_KEY=
SUNBIRD_BASE_URL=https://api.sunbird.ai

# Local Postgres from docker-compose. On Vercel, set this to your Neon pooled connection string.
DATABASE_URL=postgres://eddembe:eddembe@localhost:5433/eddembe

# Local API port (not used on Vercel)
PORT=4100
